      "template <typename T = int>\nclass DSU {\nprivate:\n    vector<T> parent;\n    vector<int> rank, mini, maxi, s;\n\npublic:\n    DSU(T n) : parent(n), rank(n, 0), mini(n), maxi(n), s(n) {\n        iota(parent.begin(), parent.end(), 0);\n        for (int i = 0; i < n; ++i) {\n            s[i] = 1;\n            mini[i] = maxi[i] = i;\n        }\n    }\n\n    T find(T x) {\n        while (x != parent[x]) {\n            x = parent[x] = parent[parent[x]];\n        }\n        return x;\n    }\n\n    bool merge(T x_, T y_) {\n        T x = find(x_);\n        T y = find(y_);\n\n        if (x == y) return false; \n\n        if (rank[x] < rank[y]) {\n            parent[x] = y;\n            mini[y] = min(mini[y], mini[x]);\n            maxi[y] = max(maxi[y], maxi[x]);\n            s[y] += s[x];\n        } else if (rank[x] >= rank[y]) {\n            parent[y] = x;\n            rank[x] += (rank[x] == rank[y]);\n            mini[x] = min(mini[y], mini[x]);\n            maxi[x] = max(maxi[y], maxi[x]);\n            s[x] += s[y];\n        };\n        return true;\n    }\n\n    bool connected(T x, T y) {\n        return find(x) == find(y);\n    }\n    int get_rank(T x) {\n        return rank[find(x)];\n    }\n    int minel(T x) {\n        return mini[find(x)];\n    }\n    int maxel(T x) {\n        return maxi[find(x)];\n    }\n    int size(T x) {\n        return s[find(x)];\n    }\n};"
