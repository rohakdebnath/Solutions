      "void counting_sort(vector<int>& p, const vector<int>& c) {\n    int n = p.size();\n    vector<int> cnt(n, 0);\n    for (int x : c) cnt[x]++;\n    vector<int> pos(n);\n    for (int i = 1; i < n; ++i) pos[i] = pos[i - 1] + cnt[i - 1];\n\n    vector<int> p_new(n);\n    for (int x : p) {\n        int i = c[x];\n        p_new[pos[i]++] = x;\n    }\n    p = p_new;\n}\n\nvector<int> sufar(string& s) {\n    int n = s.size();\n\n    vector<int> p(n), c(n);\n    {\n        vector<pair<char, int>> a(n);\n        for (int i = 0; i < n; ++i) a[i] = {s[i], i};\n        sort(a.begin(), a.end());\n        for (int i = 0; i < n; ++i) p[i] = a[i].second;\n\n        c[p[0]] = 0;\n        for (int i = 1; i < n; ++i) {\n            if (a[i].first == a[i - 1].first)\n                c[p[i]] = c[p[i - 1]];\n            else\n                c[p[i]] = c[p[i - 1]] + 1;\n        }\n    }\n\n    int k = 0;\n    while ((1 << k) < n) {\n        for (int i = 0; i < n; ++i) {\n            p[i] = (p[i] - (1 << k) + n) % n;\n        }\n\n        counting_sort(p, c);\n\n        vector<int> c_new(n);\n        c_new[p[0]] = 0;\n        for (int i = 1; i < n; ++i) {\n            pair<int, int> prev = {c[p[i - 1]], c[(p[i - 1] + (1 << k)) % n]};\n            pair<int, int> now = {c[p[i]], c[(p[i] + (1 << k)) % n]};\n            if (now == prev)\n                c_new[p[i]] = c_new[p[i - 1]];\n            else\n                c_new[p[i]] = c_new[p[i - 1]] + 1;\n        }\n        c = std::move(c_new);\n        k++;\n    }\n\n    return p;\n}"
